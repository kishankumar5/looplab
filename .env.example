# Copy to .env (git-ignored) and fill in. Never commit real values.
# On Vercel, set these under Project > Settings > Environment Variables
# (the Neon integration fills in DATABASE_URL for Production and Preview).

# Postgres connection string. Locally: the Docker database from the README.
DATABASE_URL="postgresql://looplab:looplab@localhost:5433/looplab"

# Separate database for integration tests (npm test). Leave unset to skip them.
DATABASE_URL_TEST="postgresql://looplab:looplab@localhost:5433/looplab_test"

# Signs session cookies (Auth.js). Generate with: openssl rand -base64 32
AUTH_SECRET=""
