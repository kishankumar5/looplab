// LoopLab database schema (PRD section 6, issue #3).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  displayName  String
  passwordHash String
  createdAt    DateTime @default(now())

  beats Beat[]
  likes Like[]
}

model Beat {
  id       String  @id @default(cuid())
  ownerId  String
  owner    User    @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  title    String  @default("Untitled beat")
  /// Beat pattern JSON (PRD section 6). Validate with beatPatternSchema before saving and after loading.
  pattern  Json
  isPublic Boolean @default(false)

  /// The beat this one was remixed from. Set to null if the original is deleted.
  remixedFromId String?
  /// True for remixes, even after the original is deleted (so the page can say the original is gone).
  isRemix       Boolean @default(false)
  remixedFrom   Beat?   @relation("Remixes", fields: [remixedFromId], references: [id], onDelete: SetNull)
  remixes       Beat[]  @relation("Remixes")

  likes     Like[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ownerId, updatedAt])
  @@index([isPublic, createdAt])
}

model Like {
  userId    String
  beatId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  beat      Beat     @relation(fields: [beatId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([userId, beatId])
  @@index([beatId])
}
